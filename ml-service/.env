# .env Configuration for OleaCare

# === Backend Configuration ===
PORT=3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/oleacare
# For MongoDB Atlas cloud:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/oleacare?retryWrites=true&w=majority

# JWT - Change this to a strong secret in production!
JWT_SECRET=oleacare_dev_secret_key_change_in_production_2024
JWT_EXPIRY=7d

# API Security
IOT_API_KEY=oleacare_iot_api_key_dev_2024

# CORS - Allow frontend origin
CORS_ORIGIN=http://localhost:4200

# Socket.io
SOCKET_PORT=3000

# ML Service
ML_SERVICE_URL=http://localhost:5000

# === ML Service Configuration ===
FLASK_PORT=5000
FLASK_ENV=development

# === Frontend Configuration (in frontend/.env) ===
# API_URL=http://localhost:3000/api
# SOCKET_URL=http://localhost:3000
